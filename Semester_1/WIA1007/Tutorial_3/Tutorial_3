        "\n",
        "# Tutorial_3\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Load Dataset\n",
        "url = \"https://raw.githubusercontent.com/mwaskom/seaborn-data/master/titanic.csv\"\n",
        "df = pd.read_csv(url)\n",
        "\n",
        "# Q1 - Load and Visualize Dataset\n",
        "print(\"First 5 rows:\")\n",
        "display(df.head())\n",
        "\n",
        "print(\"\\nDataset Overview:\")\n",
        "df.info()\n",
        "\n",
        "# Visualize Survival Count\n",
        "sns.countplot(data=df, x=\"survived\")\n",
        "plt.title(\"Titanic Survival Count\")\n",
        "plt.xlabel(\"Survived (0 = No, 1 = Yes)\")\n",
        "plt.ylabel(\"Number of Passengers\")\n",
        "plt.show()\n",
        "\n",
        "# Q2 - Evaluate Data Quality\n",
        "print(\"\\nData Quality:\")\n",
        "print(\"Number of duplicate rows:\", df.duplicated().sum())\n",
        "print(\"Total missing values:\", df.isnull().sum().sum())\n",
        "print(\"\\nStatistical Summary:\")\n",
        "display(df.describe())\n",
        "\n",
        "# Q3 - Number of Features\n",
        "feature_columns = [\n",
        "    \"pclass\", \"sex\", \"age\", \"sibsp\",\n",
        "    \"parch\", \"fare\", \"embarked\", \"alone\"\n",
        "]\n",
        "\n",
        "print(\"\\nNumber of selected features:\", len(feature_columns))\n",
        "print(\"Features:\", feature_columns)\n",
        "\n",
        "# Q4 - Number of Samples / Observations\n",
        "print(\"\\nNumber of samples:\", df.shape[0])\n",
        "\n",
        "# Q5 - Data Types\n",
        "print(\"\\nData Types:\")\n",
        "print(df.dtypes)\n",
        "\n",
        "# Q6 - Columns Containing Null Values\n",
        "print(\"\\nNull Values Per Column:\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "print(\"\\nColumns with Null Values:\")\n",
        "print(df.columns[df.isnull().any()].tolist())\n",
        "\n",
        "# Q7 - Features and Target Output\n",
        "X = df[feature_columns]\n",
        "y = df[\"survived\"]\n",
        "\n",
        "print(\"\\nInput Features:\")\n",
        "print(X.columns.tolist())\n",
        "\n",
        "print(\"\\nTarget Output:\")\n",
        "print(y.name)\n",
        "\n",
        "# Q8 - Find Missing Values and Rows\n",
        "print(\"\\nMissing Values:\")\n",
        "for column in df.columns:\n",
        "    missing_rows = df.index[df[column].isnull()] + 1\n",
        "\n",
        "    if len(missing_rows) > 0:\n",
        "        print(f\"\\nColumn: {column}\")\n",
        "        print(\"Missing rows:\", missing_rows.tolist())\n",
        "        print(\"Number of missing values:\", len(missing_rows))\n",
        "\n",
        "# Q9 - Research Question and Visualization\n",
        "print(\"\\nResearch Question:\")\n",
        "print(\"Which factors are associated with Titanic passenger survival?\")\n",
        "\n",
        "# Survival by Gender\n",
        "sns.countplot(data=df, x=\"sex\", hue=\"survived\")\n",
        "plt.title(\"Survival by Gender\")\n",
        "plt.xlabel(\"Gender\")\n",
        "plt.ylabel(\"Number of Passengers\")\n",
        "plt.show()\n",
        "\n",
        "# Survival by Passenger Class\n",
        "sns.countplot(data=df, x=\"pclass\", hue=\"survived\")\n",
        "plt.title(\"Survival by Passenger Class\")\n",
        "plt.xlabel(\"Passenger Class\")\n",
        "plt.ylabel(\"Number of Passengers\")\n",
        "plt.show()\n",
        "\n",
        "# Age Distribution\n",
        "sns.histplot(data=df, x=\"age\", hue=\"survived\", bins=30,\n",
        "             multiple=\"layer\")\n",
        "plt.title(\"Age Distribution by Survival\")\n",
        "plt.xlabel(\"Age\")\n",
        "plt.ylabel(\"Number of Passengers\")\n",
        "plt.show()\n"
      ]
    }
  ]
